{
  "compilerOptions": {
    "outDir": "./compilledTs",        // Output directory for compiled .js files
    "module": "ESNext",
    "target": "ESNext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true
  },
  "include": ["*.ts"]
}
